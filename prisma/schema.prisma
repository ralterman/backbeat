// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  videos              Video[]
  subscription        Subscription?
  usageRecords        UsageRecord[]
  emailChangeRequests EmailChangeRequest[]
}

/// A pending request to change a user's email. The new address is only
/// written to User.email once the token (sent to the new address) is used.
model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String   @unique // sha256 of the raw token; raw token only ever lives in the email link
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Processed Stripe webhook event IDs, for idempotency (Stripe delivers at-least-once).
model StripeEvent {
  id          String   @id // Stripe event id (evt_…)
  type        String
  processedAt DateTime @default(now())
}

model Video {
  id           String      @id @default(cuid())
  userId       String
  filename     String
  originalName String
  s3Key        String
  s3Bucket     String
  fileSize     Int
  mimeType     String
  status       VideoStatus @default(PENDING)
  // First-frame poster for the results-page preview player — see
  // src/app/api/analyze/route.ts (reuses a frame already extracted for
  // Claude, no extra ffmpeg pass). Null for videos analyzed before this
  // field existed; the player falls back to preload="metadata" for those.
  thumbnailKey String?
  thumbnailUrl String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis?
  exports  Export[]
}

enum VideoStatus {
  PENDING
  UPLOADING
  UPLOADED
  ANALYZING
  GENERATING
  ANALYZED
  FAILED
}

model Analysis {
  id                String   @id @default(cuid())
  videoId           String   @unique
  moodTags          String[]
  bpmRange          Json
  energyScore       Float
  sceneTags         String[]
  recommendedGenres String[]
  rawResponse       String?  @db.Text
  // ElevenLabs-generated music — option 1 (primary genre match)
  musicDescription  String?  @db.Text
  musicTags         String[]
  generatedAudioKey String?           // S3 key (permanent)
  generatedAudioUrl String?  @db.Text // presigned URL (24 h, refreshed on read)
  // ElevenLabs-generated music — option 2 (cinematic / orchestral alternative)
  musicDescription2  String?  @db.Text
  musicTags2         String[] @default([])
  generatedAudioKey2 String?
  generatedAudioUrl2 String?  @db.Text
  // Accumulated options across all rounds (source of truth going forward)
  generatedOptions   Json     @default("[]")
  // Whether the uploaded video has its own audio track (ffprobe'd once at
  // first analysis — see extractFrames() in analyze/route.ts). Defaults true
  // so pre-existing rows (never probed) keep the "keep my audio" option
  // available rather than silently losing it; a genuinely silent video just
  // mixes in silence, which is harmless.
  hasOriginalAudio   Boolean  @default(true)
  createdAt          DateTime @default(now())

  video        Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  trackMatches TrackMatch[]
}

model TrackMatch {
  id         String   @id @default(cuid())
  analysisId String
  trackId    String
  matchScore Float
  rank       Int
  createdAt  DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model Export {
  id           String       @id @default(cuid())
  videoId      String
  trackId      String?      // nullable — was catalog track ID; now unused with generated audio
  userId       String
  status       ExportStatus @default(PENDING)
  s3OutputKey  String?
  downloadUrl  String?
  expiresAt    DateTime?
  hasWatermark Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  // True when the user has canceled in the portal but keeps access until
  // currentPeriodEnd. Lets the UI show "cancels on <date>".
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionPlan {
  FREE
  CREATOR
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  action    String
  month     String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, month])
}
