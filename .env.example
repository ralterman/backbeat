# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Resend - for magic link auth)
RESEND_API_KEY=re_your_resend_api_key
# Local testing only: =1 prints the magic-link URL to the server console
# instead of emailing it. Ignored in production builds.
# MAGIC_LINK_DEBUG_URL=1
EMAIL_FROM=noreply@yourdomain.com

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_INPUT=backbeat-videos-input
AWS_S3_BUCKET_OUTPUT=backbeat-videos-output

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ElevenLabs (music generation)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Music model_id sent to the video-to-music endpoint. Optional; the code
# falls back to music_v2_5. Known values: music_v2, music_v2_5.
ELEVENLABS_MUSIC_MODEL=music_v2_5
# The key also needs the "User" (user_read) permission for the daily credit
# check (/api/cron/elevenlabs-credits) to read the balance.

# Vercel Cron (schedules live in vercel.json). Vercel sends
# `Authorization: Bearer $CRON_SECRET` on each invocation; the cron routes
# refuse anything else. Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable
STRIPE_CREATOR_PRICE_ID=price_your-creator-price-id
STRIPE_TEAM_PRICE_ID=price_your-team-price-id

# Cloudflare Turnstile (contact form bot check). Create a widget at
# https://dash.cloudflare.com → Turnstile with hostname backbeat.video.
# The site key is public and read in the browser, so it must carry the
# NEXT_PUBLIC_ prefix (Next.js only exposes those to client code, and bakes
# them in at build time — redeploy after changing it). The secret is
# server-only. With either unset, the form still works but skips Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# FFmpeg path (optional, defaults to system ffmpeg)
FFMPEG_PATH=/usr/bin/ffmpeg
